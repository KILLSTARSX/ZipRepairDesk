#include <windows.h>
#include <winver.h>

1 ICON "assets/ZipRepairDesk.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,2,0,0
 PRODUCTVERSION 2,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "KILL-STAR SX"
      VALUE "FileDescription", "Disguised ZIP Repair Desk"
      VALUE "FileVersion", "2.2.0.0"
      VALUE "InternalName", "ZipRepairDesk"
      VALUE "LegalCopyright", "KILL-STAR SX"
      VALUE "OriginalFilename", "ZipRepairDesk.exe"
      VALUE "ProductName", "Zip Repair Desk"
      VALUE "ProductVersion", "2.2"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
